{
  "name": "@flowtask/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@flowtask/auth": "workspace:*",
    "@flowtask/database": "workspace:*",
    "@flowtask/domain": "workspace:*",
    "@flowtask/integrations": "workspace:*",
    "@flowtask/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^2.0.0",
    "ai": "^6.0.84",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "~1.3.11",
    "typescript": "^5.7.2"
  }
}
