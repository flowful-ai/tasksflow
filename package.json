{
  "name": "flowtask",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive task management platform with GitHub/Slack integrations and AI agent capabilities",
  "author": "FlowTask Team",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "turbo run dev --filter=@flowtask/api --filter=@flowtask/web",
    "build": "turbo run build",
    "lint": "turbo run typecheck",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "bun --filter @flowtask/database db:generate",
    "db:migrate": "bun --filter @flowtask/database db:migrate",
    "db:push": "bun --filter @flowtask/database db:push",
    "db:studio": "bun --filter @flowtask/database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/bun": "~1.3.11",
    "prettier": "^3.4.2",
    "turbo": "^2.9.18",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.13",
    "@hono/node-server": "^2.1.6",
    "axios": "^1.21.0",
    "baseline-browser-mapping": "^2.11.0",
    "better-auth": "^1.7.18",
    "body-parser": "^2.4.0",
    "browserslist": "^4.29.0",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.3",
    "form-data": "^4.0.6",
    "hono": "^4.13.17",
    "ip-address": "^10.7.6",
    "nanoid": "^3.3.18",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "rollup": "^4.62.0",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "vite": "^6.4.5",
    "ws": "^8.20.1"
  }
}
