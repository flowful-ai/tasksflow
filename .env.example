# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Either a full URL...
DATABASE_URL=postgresql://flowtask:flowtask@localhost:5432/flowtask
# ...or, when DATABASE_URL is unset, the parts below (URL-encoded by the API,
# so any characters are safe in the password). docker-compose.prod.yml uses these.
POSTGRES_USER=flowtask
POSTGRES_PASSWORD=
POSTGRES_DB=flowtask
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Connections per API process (default 10)
DB_POOL_MAX=10
# Apply drizzle migrations on boot, under an advisory lock (default true)
RUN_MIGRATIONS=true
# Override where migrations are read from (default: packages/database/drizzle, or /app/drizzle in the image)
# MIGRATIONS_DIR=

# ---------------------------------------------------------------------------
# Authentication (Better Auth). Sign-up is GitHub/Google only.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
# Public base URL of the API (in production, the app's https URL)
BETTER_AUTH_URL=http://localhost:3001
# Public URL used for OAuth/MCP metadata when it differs from BETTER_AUTH_URL (optional)
# PUBLIC_URL=
# Public URL of the web app. With BETTER_AUTH_URL, the only trusted origin
# (CORS and auth) in production; localhost origins are added outside production.
WEB_URL=http://localhost:3000
# Comma-separated emails that get the app_manager role on sign-up or next login.
# When unset, the first account created becomes app manager.
APP_MANAGER_EMAILS=
# Reverse proxies in front of the API that append to X-Forwarded-For
# (1 = Dokploy's Traefik; 0 = use the socket address)
TRUSTED_PROXY_HOPS=1

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web build flags: a non-empty value shows the matching sign-in button.
# (docker-compose.prod.yml defaults them to GITHUB_CLIENT_ID / GOOGLE_CLIENT_ID)
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Leave empty: the SPA calls the API on its own origin
# VITE_API_URL=

# ---------------------------------------------------------------------------
# GitHub App (integration)
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The App's own OAuth client (Settings > "Client ID"/"Client secrets"), used to
# verify that the installing user can access the installation. Enable
# "Request user authorization (OAuth) during installation" and set the setup
# URL to <BETTER_AUTH_URL>/api/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# App slug for the installation URL (server and web build)
GITHUB_APP_SLUG=flowtask
VITE_GITHUB_APP_SLUG=flowtask

# ---------------------------------------------------------------------------
# Slack App (integration)
# ---------------------------------------------------------------------------
# OAuth install ("Add to Slack"): bot tokens are stored per project, encrypted.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Defaults to <BETTER_AUTH_URL>/api/webhooks/slack/oauth (optional)
# SLACK_REDIRECT_URI=
# Workspace-wide fallback bot token when a project has no Slack install (optional)
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Encryption and AI
# ---------------------------------------------------------------------------
# Required: encrypts stored API keys. Use 32 random bytes as hex or base64
# (openssl rand -hex 32); other values work but log a warning.
API_KEY_ENCRYPTION_KEY=your-encryption-key-min-32-chars-here
# Encrypts integration secrets (Slack bot tokens); defaults to API_KEY_ENCRYPTION_KEY
# INTEGRATION_ENCRYPTION_KEY=
# Timeout for OpenRouter calls in ms (optional)
OPENROUTER_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# Built SPA to serve (default: apps/web/dist, or /app/public in the image)
# WEB_DIST_DIR=
# Per-phase shutdown timeout in ms (hooks, then draining requests)
# SHUTDOWN_TIMEOUT_MS=10000
# Disable the Postgres job runner in this process (default false)
# JOBS_DISABLED=false
# Allow outgoing webhooks to private/loopback addresses (dev only; default false)
# ALLOW_PRIVATE_WEBHOOK_TARGETS=false
