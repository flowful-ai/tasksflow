# FlowTask environment. Copy to .env at the repo root for `bun run dev`
# (the API loads it with --env-file, Vite reads VITE_* from the same file).
# In production these come from the Dokploy environment; see docs/deploy.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Either a full URL...
DATABASE_URL=postgresql://flowtask:flowtask@localhost:5432/flowtask
# ...or, when DATABASE_URL is unset, the parts below (URL-encoded by the API,
# so any characters are safe in the password). docker-compose.prod.yml uses these.
# Note: realtime fan-out across API instances (Postgres LISTEN/NOTIFY) reads
# DATABASE_URL only; with just the parts below, events stay on one instance.
POSTGRES_USER=flowtask
POSTGRES_PASSWORD=
POSTGRES_DB=flowtask
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Connections per API process (default 10)
DB_POOL_MAX=10
# Apply drizzle migrations on boot, under an advisory lock (default true; "false" or "0" disables)
RUN_MIGRATIONS=true
# Override where migrations are read from (default: apps/api/drizzle, or /app/drizzle in the image)
# MIGRATIONS_DIR=

# ---------------------------------------------------------------------------
# Authentication (Better Auth). Sign-up is GitHub/Google only; existing
# email/password accounts can still sign in.
# ---------------------------------------------------------------------------
# Required: signs sessions. At least 32 random characters (openssl rand -hex 32).
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
# Public base URL of the API (in production, the app's https URL). OAuth
# callbacks are <BETTER_AUTH_URL>/api/auth/callback/github and .../google.
BETTER_AUTH_URL=http://localhost:3001
# Public URL used for OAuth/MCP metadata when it differs from BETTER_AUTH_URL (optional)
# PUBLIC_URL=
# MCP OAuth redirect URIs must be https, loopback http, or a reverse-domain
# scheme (com.example.app:). Dotless app schemes are allowlisted: cursor,
# vscode, vscode-insiders, windsurf. Add more, comma-separated (optional):
# MCP_ALLOWED_REDIRECT_SCHEMES=zed
# Public URL of the web app (dev: the Vite server). With BETTER_AUTH_URL, the
# only trusted origin (CORS and auth) in production; localhost origins are
# added outside production. docker-compose.prod.yml defaults it to BETTER_AUTH_URL.
WEB_URL=http://localhost:3000
# Comma-separated emails that get the app_manager role on sign-up or next login.
# When unset, the first account created becomes app manager.
APP_MANAGER_EMAILS=
# Reverse proxies in front of the API that append to X-Forwarded-For
# (1 = Dokploy's Traefik; 0 = use the socket address)
TRUSTED_PROXY_HOPS=1

# GitHub OAuth app for "Sign in with GitHub" (login only; the integration uses
# the GitHub App below). The provider is enabled when both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client for "Sign in with Google". Enabled when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web build flags: a non-empty value shows the matching sign-in button.
# (docker-compose.prod.yml defaults them to GITHUB_CLIENT_ID / GOOGLE_CLIENT_ID)
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Leave empty: the SPA calls the API on its own origin
# VITE_API_URL=

# ---------------------------------------------------------------------------
# GitHub App (integration)
# ---------------------------------------------------------------------------
# Numeric App ID from the App's settings page.
GITHUB_APP_ID=
# The App's private key (.pem): the PEM itself with \n for newlines, or base64 of the file.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret configured on the App; webhooks are rejected while it is unset.
GITHUB_WEBHOOK_SECRET=
# The App's own OAuth client (Settings > "Client ID"/"Client secrets"), used to
# verify that the installing user can access the installation. Enable
# "Request user authorization (OAuth) during installation" and set the App's
# callback URL to <BETTER_AUTH_URL>/api/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# App slug for the installation URL (github.com/apps/<slug>), server and web build
GITHUB_APP_SLUG=flowtask
VITE_GITHUB_APP_SLUG=flowtask

# ---------------------------------------------------------------------------
# Slack App (integration, notifications only)
# ---------------------------------------------------------------------------
# OAuth install ("Add to Slack"): bot tokens are stored per project, encrypted.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies requests to /api/webhooks/slack (slash commands, events)
SLACK_SIGNING_SECRET=
# Defaults to <BETTER_AUTH_URL>/api/webhooks/slack/oauth (optional)
# SLACK_REDIRECT_URI=
# Workspace-wide fallback bot token when a project has no Slack install (optional)
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Encryption and AI
# ---------------------------------------------------------------------------
# Required: encrypts stored API keys. Use 32 random bytes as hex or base64
# (openssl rand -hex 32); other values work but log a warning.
API_KEY_ENCRYPTION_KEY=your-encryption-key-min-32-chars-here
# Encrypts integration secrets (Slack bot tokens); defaults to API_KEY_ENCRYPTION_KEY
# INTEGRATION_ENCRYPTION_KEY=
# Timeout for OpenRouter calls in ms (optional, default 120000)
OPENROUTER_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# "production" enables HSTS, the production CORS/origin rules and proxy-safe URLs
NODE_ENV=development
# Port and interface the API listens on (defaults 3001 and 0.0.0.0)
API_PORT=3001
API_HOST=0.0.0.0
# Built SPA to serve (default: apps/web/dist, or /app/public in the image)
# WEB_DIST_DIR=
# Per-phase shutdown timeout in ms (hooks, then draining requests)
# SHUTDOWN_TIMEOUT_MS=10000
# Disable the Postgres job runner in this process (default false)
# JOBS_DISABLED=false
# Allow outgoing webhooks to private/loopback addresses (dev only; default false)
# ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Database for integration tests. It is truncated and re-seeded: never point
# it at data you care about. Unset = database suites skip themselves.
# TEST_DATABASE_URL=postgresql://flowtask:flowtask@localhost:5432/flowtask_test
