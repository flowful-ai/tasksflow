{
  "name": "@flowtask/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "bun": "./src/types/index.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./utils": {
      "bun": "./src/utils/index.ts",
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./constants": {
      "bun": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./json": {
      "bun": "./src/types/json.ts",
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "zod": "^3.24.1"
  }
}
